# Copy to .env and replace every value. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PIPELINE_DB_PASSWORD=
DASHBOARD_DB_PASSWORD=
CACHE_REFRESH_TOKEN=
SECRET_KEY=
# Language the dashboard opens in (en, fr, pt); visitors switch with the
# language links, and their choice is kept when they reload the page.
DEFAULT_LANGUAGE=fr
# Last year with closed accounts (2025 when unset). Charts of executed spending
# stop there; charts of the budget alone show every year that has a budget.
END_YEAR=2025
# Dashboard sections. SHOW_SUBNATIONAL=true adds the "Across space" tab to the
# overview, education and health pages (false when unset).
SHOW_SUBNATIONAL=false
# Chart sections removed, by chart id, comma-separated; set to nothing, no
# chart is removed (education-outcome,health-outcome when the line is absent).
HIDDEN_CHARTS=education-outcome,health-outcome
# true adds the interpretation sentences to the narratives ("This might
# suggest a policy shift...") (false when unset).
SHOW_NARRATIVE_INTERPRETATION=false
# 1 enables login; users are read from prd_mega.sboost4.dashboard_user_credentials.
AUTH_ENABLED=0
# Host address:port the dashboard listens on; the reverse proxy targets it.
DASHBOARD_BIND=127.0.0.1:8080
# Directory with the source files that are not public, mounted read-only into
# the pipeline at /data: BOOST exports in togo/*.xlsx, PEFA scores in
# pefa/pefa_2011_bronze.csv and pefa/pefa_2016_bronze.csv.
INPUT_DIR=./data
# Image tag to run in an installation package (set by the package). In the
# repository, make takes it from the checked-out commit (scripts/release-name.sh).
RELEASE=dev
# Global Data Lab API token (globaldatalab.org > My GDL > API Access);
# without it the subnational human development index stays empty.
GDL_API_TOKEN=
# Optional Metabase (make metabase-up), which adds METABASE_DB_PASSWORD,
# METABASE_READER_PASSWORD and METABASE_ENCRYPTION_KEY with generated values.
# Keep METABASE_ENCRYPTION_KEY with this file: it decrypts the connection
# settings Metabase stores. Address it listens on, and its Java heap:
#METABASE_BIND=127.0.0.1:3000
#METABASE_JAVA_OPTS=-Xmx1g
